# Secrets: never commit a real key
.env
.env.*
!.env.example

# Local development notes and credit log
.dev/

# Virtual environments
.venv/
venv/
.venv-*/

# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

