# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional: override where the local search cache is stored (defaults to the OS user cache dir).
# GHOSTCITE_CACHE_DIR=

# Optional: where live runs log how many searches they used (counts only, never the key).
# Default: .dev/credits.log in a development checkout, else credits.log next to the cache.
# GHOSTCITE_CREDITS_LOG=

# Optional: true for a public, demo-only deployment (render.yaml sets it). The web UI then
# refuses every live check, even if a key is set. Default: false.
# GHOSTCITE_HOSTED_DEMO=false
