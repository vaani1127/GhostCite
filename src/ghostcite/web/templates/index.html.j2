<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GhostCite: check citations against Google Scholar</title>
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head>
<body>
<a class="skip" href="#check-form">Skip to the form</a>
<header class="top">
  <div>
    <p class="brand">GhostCite</p>
    <p class="hero">LLM-written papers cite papers that do not exist. GhostCite checks every reference against live Google Scholar data.</p>
  </div>
  <button type="button" id="theme" class="ghost" aria-label="Switch between light and dark theme">Theme</button>
</header>

<main>
  <ol class="steps" aria-label="How it works">
    <li><span class="step-n" aria-hidden="true">1</span><div><strong>Parse references</strong><span>From a PDF, a .bib file or pasted text: authors, title, year and venue.</span></div></li>
    <li><span class="step-n" aria-hidden="true">2</span><div><strong>Search Google Scholar via SerpApi</strong><span>Exact title first, then title plus author, with a Google fallback for books.</span></div></li>
    <li><span class="step-n" aria-hidden="true">3</span><div><strong>Compare fields and explain</strong><span>Each verdict says which field differs from the real paper, and why.</span></div></li>
  </ol>

  {% if hosted %}
  <section class="banner" role="status">
    <strong>This hosted copy runs in demo mode only.</strong>
    Run GhostCite locally with your own SerpApi key for live checks:
    <a href="{{ project_url }}" rel="noopener noreferrer">{{ project_url }}</a>.
    Try the sample here; pasted references that are not in the sample are shown as Skipped.
  </section>
  {% elif not has_key %}
  <section class="banner" role="status">
    <strong>No API key found: demo mode only.</strong>
    {% if demo_ready %}
    You can check the bundled sample with recorded Google Scholar results, with no key and no credits needed.
    {% else %}
    The demo data is not installed either.
    {% endif %}
    To check your own documents, put <code>SERPAPI_API_KEY=...</code> in a <code>.env</code> file and restart <code>ghostcite web</code>.
  </section>
  {% endif %}

  <form id="check-form" class="card" novalidate>
    <div class="form-head">
      <h1>Check a reference list</h1>
      <div class="quick">
        <button type="button" id="sample" class="secondary" {% if not demo_ready %}disabled aria-describedby="sample-hint"{% endif %}>Try the sample</button>
        {% if demo_ready %}
        <p class="hint">One click: a sample bibliography of real and fabricated references, checked against recorded results. No key, no credits.</p>
        {% else %}
        <p id="sample-hint" class="hint">Unavailable: the demo data is not installed. Build it with <code>python scripts/build_demo_bundle.py</code>.</p>
        {% endif %}
      </div>
    </div>
    <div class="inputs">
      <div class="field">
        <label for="file">Upload a PDF, .bib or .txt file <span class="muted">(max {{ (cfg.max_upload_bytes // 1048576) }} MiB)</span></label>
        <input id="file" name="file" type="file" accept=".pdf,.bib,.txt,application/pdf,text/plain">
      </div>
      <p class="or" aria-hidden="true">or</p>
      <div class="field">
        <label for="text">Paste references (one per line, or a numbered list)</label>
        <textarea id="text" name="text" rows="5" spellcheck="false" placeholder="[1] A. Vaswani et al., &ldquo;Attention is all you need,&rdquo; NeurIPS, 2017."></textarea>
      </div>
    </div>

    <fieldset class="field">
      <legend>Search mode</legend>
      <label class="choice{% if not has_key %} off{% endif %}">
        <input type="radio" name="mode" value="live" {% if has_key %}checked{% else %}disabled aria-describedby="live-hint"{% endif %}>
        <span><strong>Live</strong>: search Google Scholar through SerpApi, up to {{ cfg.per_job_search_cap }} searches per check. Results are cached, so repeats are free.
        {% if hosted %}<span id="live-hint" class="hint">Unavailable on this hosted copy: it runs in demo mode only. Run GhostCite locally with your own SerpApi key for live checks.</span>
        {% elif not has_key %}<span id="live-hint" class="hint">Unavailable: no <code>SERPAPI_API_KEY</code> in <code>.env</code>.</span>{% endif %}</span>
      </label>
      <label class="choice{% if not demo_ready %} off{% endif %}">
        <input type="radio" name="mode" value="demo" {% if not has_key and demo_ready %}checked{% endif %} {% if not demo_ready %}disabled aria-describedby="demo-hint"{% endif %}>
        <span><strong>Demo</strong>: recorded results for the sample references; no key or credits needed. With no file or text, the sample is checked.
        {% if not demo_ready %}<span id="demo-hint" class="hint">Unavailable: the demo data is not installed.</span>{% endif %}</span>
      </label>
    </fieldset>

    <div class="actions">
      <button type="submit" id="submit" {% if not has_key and not demo_ready %}disabled aria-describedby="submit-hint"{% endif %}>Check citations</button>
      {% if not has_key and not demo_ready %}
      <p id="submit-hint" class="hint">Unavailable: add an API key, or install the demo data, to run a check.</p>
      {% endif %}
    </div>
    <p id="error" class="error" role="alert" hidden></p>
  </form>

  <section id="progress" class="card" hidden aria-labelledby="progress-heading">
    <h2 id="progress-heading">Checking references</h2>
    <progress id="bar" max="1" value="0" aria-describedby="progress-text"></progress>
    <p id="progress-text" aria-live="polite">Starting&hellip;</p>
    <ol id="ticks" class="ticks" aria-label="Verdicts so far"></ol>
  </section>
</main>

<footer class="muted">
  {% if hosted %}
  This is a hosted demo copy of GhostCite {{ version }}. Uploads are processed in memory and never stored; there are no cookies and no tracking.
  Live checks against Google Scholar need a local run with your own SerpApi key (<a href="{{ project_url }}" rel="noopener noreferrer">see the README</a>).
  {% else %}
  GhostCite {{ version }} runs on your machine. Uploads are processed in memory and never stored; there are no cookies and no tracking.
  Verdicts are deterministic comparisons with Google Scholar data retrieved through SerpApi.
  {% endif %}
</footer>
</body>
</html>
